# Razorpay API Credentials (TEST MODE ONLY)
# Obtain these from Razorpay Dashboard -> Settings -> API Keys (ensure Test Mode is active)
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere

# LLM Provider Configuration
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-2.0-flash

# Database Configuration
DATABASE_URL=sqlite:///./recovery_agent.db

# Simulation and Orchestration Settings
DEMO_TIME_MULTIPLIER=1.0
RANDOM_SEED=42

# Application Settings
APP_NAME="Razorpay AI Revenue Recovery Agent"
APP_VERSION=0.1.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
